{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index.js"
    },
    {
      "source": "/servicos",
      "destination": "/public/servicos.html"
    },
    {
      "source": "/todos-servicos",
      "destination": "/public/todos-servicos.html"
    },
    {
      "source": "/login",
      "destination": "/public/login.html"
    },
    {
      "source": "/cadastro",
      "destination": "/public/cadastro.html"
    },
    {
      "source": "/app-simulador",
      "destination": "/public/app_simulador.html"
    },
    {
      "source": "/dashboard",
      "destination": "/public/dashboard.html"
    },
    {
      "source": "/:path*",
      "destination": "/public/:path*"
    }
  ]
}
